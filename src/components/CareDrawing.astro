---
import {site} from '../lib/content';
---
<figure class="visit-signature care-drawing">
  <svg viewBox="0 0 80 80" role="img" aria-labelledby="care-title care-description" data-care-motion>
    <title id="care-title">Un cuidado que parte de la persona</title>
    <desc id="care-description">Cinco pétalos abiertos se reúnen alrededor de un centro: una representación de escuchar, orientar y acompañar.</desc>
    <g fill="none" stroke="currentColor" stroke-width="1.8">
      <ellipse data-care-petal cx="40" cy="24" rx="11" ry="18"/>
      <ellipse data-care-petal cx="40" cy="24" rx="11" ry="18" transform="rotate(72 40 40)"/>
      <ellipse data-care-petal cx="40" cy="24" rx="11" ry="18" transform="rotate(144 40 40)"/>
      <ellipse data-care-petal cx="40" cy="24" rx="11" ry="18" transform="rotate(216 40 40)"/>
      <ellipse data-care-petal cx="40" cy="24" rx="11" ry="18" transform="rotate(288 40 40)"/>
    </g>
    <circle cx="40" cy="40" r="5.5" fill="currentColor"/>
  </svg>
  <figcaption>{site.brand.tagline}</figcaption>
</figure>
