---
import {site} from '../lib/content';
---
<section class="contact section" id="contacto"><div class="contact-heading"><p class="section-label">Contacto</p><h2 data-enter>{site.contact.title}</h2><p data-enter>{site.contact.text}</p><a class="email-link" href={`mailto:${site.contact.email}`}>{site.contact.email}<span aria-hidden="true">↗</span></a></div>
<form class="contact-form" novalidate data-contact-form><div class="form-row"><div><label for="name">Tu nombre *</label><input id="name" name="name" required aria-required="true" maxlength="120" autocomplete="name" aria-describedby="name-error"/><span class="field-error" id="name-error"></span></div><div><label for="email">Correo electrónico *</label><input id="email" name="email" type="email" required aria-required="true" maxlength="254" autocomplete="email" aria-describedby="email-error"/><span class="field-error" id="email-error"></span></div></div><div class="interest-field"><label for="interest">¿Sobre qué área quieres consultar?</label><select id="interest" name="interest"><option value="">Información general</option>{site.attention.items.map(item=><option value={item.id}>{item.title}</option>)}</select></div><div><label for="message">Tu mensaje para coordinación *</label><textarea id="message" name="message" required aria-required="true" rows="3" minlength="10" maxlength="1500" aria-describedby="message-help message-error"></textarea><p class="field-help" id="message-help">{site.contact.messageNote}</p><span class="field-error" id="message-error"></span></div><div class="form-bottom"><p class="form-note">{site.contact.note}</p><button class="button" type="submit" disabled aria-disabled="true">{site.contact.submit}<span aria-hidden="true">↗</span></button></div><p role="status" class="form-status" id="form-status" aria-live="polite"></p><noscript><p>Activa JavaScript para revisar el mensaje. El formulario de demostración no realiza envíos.</p></noscript></form></section>
<script>import {startForm} from '../scripts/form';startForm();</script>
