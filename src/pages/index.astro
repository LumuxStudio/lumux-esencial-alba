---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import CareDrawing from '../components/CareDrawing.astro';
import {site as s} from '../lib/content';
---
<Layout><Header/><main id="contenido">
<section class="intro section" id="inicio"><div class="intro-copy"><p class="section-label">{s.hero.label}</p><h1 data-enter>{s.hero.lines.map(line=><span>{line}</span>)}</h1><p class="intro-lede" data-enter>{s.hero.text}</p><div class="intro-actions"><a class="button" href={s.hero.cta.href}>{s.hero.cta.label}<span aria-hidden="true">↗</span></a><a class="quiet-link" href={s.hero.secondary.href}>{s.hero.secondary.label}</a></div><p class="intro-demo">Concepto de clínica · Marca ficticia</p></div><figure class="intro-photo"><img decoding="async" src={s.hero.image} srcset={`${s.hero.image.replace('.webp','-768.webp')} 768w, ${s.hero.image} 1600w`} sizes="(min-width:768px) 43vw, 100vw" width="1600" height="1067" alt={s.hero.alt} fetchpriority="high"/><figcaption>{s.hero.caption}</figcaption></figure></section>
{s.sections.includes('atencion')&&<section class="attention section" id="atencion"><div class="attention-heading"><p class="section-label">Atención</p><h2 data-enter>{s.attention.title}</h2><p data-enter>{s.attention.text}</p></div><div class="attention-index">{s.attention.items.map(item=><details class="attention-item" name="alba-attention"><summary><span>{item.title}</span><span class="expand-sign" aria-hidden="true">+</span></summary><div class="attention-detail"><p>{item.text}</p><p class="attention-footnote">{item.detail}</p><a class="quiet-link" href="#contacto" data-service={item.id}>Consultar sobre esta área <span aria-hidden="true">↗</span></a></div></details>)}</div></section>}
{s.sections.includes('primera-visita')&&<section class="first-visit section" id="primera-visita"><div class="visit-heading"><p class="section-label">Primera visita</p><h2 data-enter>{s.visit.title}</h2><p data-enter>{s.visit.text}</p><CareDrawing/></div><ol class="visit-steps">{s.visit.steps.map(step=><li><span class="step-label">{step.label}</span><div><h3>{step.title}</h3><p>{step.text}</p></div></li>)}</ol><p class="visit-note">{s.visit.note}</p></section>}
{s.sections.includes('forma')&&<section class="approach section" id="forma"><div class="approach-heading"><p class="section-label">Nuestra forma</p><h2 data-enter>{s.approach.title}</h2><p data-enter>{s.approach.text}</p></div><dl class="values-list">{s.approach.values.map(value=><div><dt>{value.title}</dt><dd>{value.text}</dd></div>)}</dl></section>}
{s.sections.includes('espacio')&&<section class="space section" id="espacio"><figure><img decoding="async" src={s.space.image} srcset={`${s.space.image.replace('.webp','-768.webp')} 768w, ${s.space.image} 1600w`} sizes="(min-width:768px) 60vw, 100vw" width="1600" height="1067" loading="lazy" alt={s.space.alt}/><figcaption>{s.space.caption}</figcaption></figure><div class="space-copy"><p class="section-label">El ambiente</p><h2 data-enter>{s.space.title}</h2><p data-enter>{s.space.text}</p></div></section>}
{s.sections.includes('preguntas')&&<section class="faq section" id="preguntas"><div class="faq-heading"><p class="section-label">Preguntas frecuentes</p><h2 data-enter>{s.faq.title}</h2><p data-enter>{s.faq.text}</p></div><div class="faq-list">{s.faq.items.map(item=><details name="alba-faq"><summary>{item.question}<span class="expand-sign" aria-hidden="true">+</span></summary><p>{item.answer}</p></details>)}</div></section>}
<Contact/><Footer/></main><script>import {startMotion} from '../scripts/motion';startMotion();</script></Layout>
